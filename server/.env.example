# NexBank API configuration
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nexbank
DB_CONNECTION_LIMIT=10

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Demo seed password used by npm run db:setup
SEED_PASSWORD=Password@123

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=600
