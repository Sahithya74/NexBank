{
  "name": "nexbank",
  "version": "1.0.0",
  "private": true,
  "description": "NexBank - online banking SaaS platform (React, Node.js/Express, MySQL)",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "db:setup": "npm run db:setup --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "demo:snapshot": "npm run demo:snapshot --prefix server",
    "build:pages": "npm run build:pages --prefix client"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
